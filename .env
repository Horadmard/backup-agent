DOCKER_IMAGE_REGISTRY=docker.io


POSTGRES_USER=astek
POSTGRES_PASSWORD=passWord
POSTGRES_DB=container
POSTGRES_HOST_AUTH_METHOD=scram-sha-256
POSTGRES_INITDB_ARGS="--auth-host=scram-sha-256 --auth-local=scram-sha-256"
BACKUP_PATH=/var/backup



RUSTFS_VOLUMES=/data/rustfs{0...3}
RUSTFS_ADDRESS=0.0.0.0:9000
RUSTFS_CONSOLE_ADDRESS=0.0.0.0:9001
RUSTFS_CONSOLE_ENABLE=true
RUSTFS_CONSOLE_CORS_ALLOWED_ORIGINS=*
RUSTFS_ACCESS_KEY=rustfsadminaccess
RUSTFS_SECRET_KEY=rustfsadminsecret
RUSTFS_OBS_LOGGER_LEVEL=info
RUSTFS_OBS_LOG_DIRECTORY=/app/logs
RUSTFS_UNSAFE_BYPASS_DISK_CHECK=true



# Agent specific envs
RUSTFS_HOST=rustfs
POSTGRES_HOST=postgres

GPG_PASSPHRASE=passWord
RUSTFS_ACCESS_KEY=rustfsadminaccess
RUSTFS_SECRET_KEY=rustfsadminsecret

POSTGRES_USER=astek
POSTGRES_PASSWORD=passWord
POSTGRES_DB=container

SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="backup@example.com"
SMTP_PASSWORD="your-password"
NOTIFICATION_TO="admin@example.com"
